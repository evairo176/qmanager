# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.out
coverage.out

# build outputs (Go & web)
/.next/
/dist/
/backend/dist/
/backend/build/
/out/
/backend/web/out/*
!/backend/web/out/.gitkeep

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build artifacts
qmanager-build/
qmanager_install/
RELEASE_NOTE.md
!docs/releases/RELEASE_NOTE.md

# claude superpowers
/.superpowers
/docs/superpowers
/.claude

# simpleadmin source
/simpleadmin-source

# bundled build tools (developer-local; not part of the repo)
/tools/

# Health check directory
/health-checks/

# Investigation scratch (probe scripts, raw logs)
/scratch/
# Go host build artifacts (device binary ships via build-discord-bot.sh tarball)
discord-bot/*.exe

# Reimagine directory
/reimagine/

# Rescue directory
/scripts-dev/rescue/

# local build artifacts (qmanager-core)
qmanager-core
qmanager-core-armv7.tar.gz
qmanager-core.service
*.deb
